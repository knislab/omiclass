# .gitignore for the project

# virtual environment and logs
.env
.venv/
venv/
*.log

# large files
data/
*.csv
*.tsv
*.xlsx
*.h5
*.h5ad
*.joblib
*.pkl
*json

# Python cache files
__pycache__/
*.pyc
.ipynb_checkpoints/

# local files
.DS_Store
toy_data/
create_toy_dataset.py

# ignore all files in the tests directory
tests/
!tests/
!tests/*.py
results/
final_results_runs/
examples/results/Docker_results/de_results/limma_voom_selected_genes.txt
examples/results/Docker_results/train_artifacts/genesets/**
examples/results/Docker_results/config.freeze.yaml
examples/results/Python_results/de_results/limma_voom_selected_genes.txt
examples/results/Python_results/config.freeze.yaml
examples/results/Python_results/train_artifacts/genesets/**
examples/results/Bash_results/de_results/limma_voom_selected_genes.txt
examples/results/Bash_results/config.freeze.yaml
examples/results/Bash_results/train_artifacts/genesets/**
BulkFormer/**

# Local CellFM runtime assets and generated embeddings
CellFM/CellFM-torch/
CellFM/weights/
CellFM/smoke_outputs/
CellFM/bulk_smoke_outputs/
CellFM/vendor/



!omiclass/data/gencode_GRCh37_hg19.csv
!omiclass/data/gencode_v34_GRCh38_hg38.csv
!omiclass/data/

!examples/data
!examples/data/patients_meta.csv
!examples/data/raw_counts.csv
!examples/data/gene_lengths.csv
!examples/data/patients_meta_with_external.csv
!examples/data/raw_counts_with_external.csv

!examples/results/
!examples/results/**/
!examples/results/**/*.html
